{
    "info": {
        "name": "Shop API 2026 - Requirements One and Two",
        "description": "توثيق المتطلبين الأول والثاني: JWT، المستخدمون، المنتجات والصور، التصنيفات، الطلبات، الإشعارات، الصلاحيات، الأخطاء الموحدة، ترويسات الأمان، تحديد محاولات الدخول، والتكامل مع خدمة المخزون المستقلة عبر gRPC. شغّل الطلبات بالترتيب بعد تشغيل Docker وتنفيذ migrations وseeding. المنتج رقم 1 مرتبط بكمية مخزون أولية مقدارها 5، والمنتج رقم 2 بكمية مقدارها 1. المنتج الجديد يبدأ بكمية صفر حتى تضاف كميته إلى خدمة المخزون. غيّر product_image_path إلى مسار صورة حقيقية قبل طلب رفع الصورة. جميع أخطاء API بالصيغة: { message: string, errors: object|null }. لاختبار توقف المخزون: نفّذ docker compose stop inventory-service، غيّر expect_inventory_unavailable إلى true، وشغّل طلب فحص تفاصيل المنتج، ثم أعد الخدمة. ولاختبار Race Condition على آخر قطعة: نفّذ docker compose exec inventory-service python demo_concurrent_reservation.py؛ يجب أن ينجح حجز واحد فقط وتفشل بقية الطلبات بنفاد المخزون.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test('Security headers are present', function () {",
                    "    pm.response.to.have.header('X-Content-Type-Options', 'nosniff');",
                    "    pm.response.to.have.header('X-Frame-Options', 'DENY');",
                    "    pm.response.to.have.header('Referrer-Policy', 'no-referrer');",
                    "    pm.response.to.have.header('Strict-Transport-Security');",
                    "});",
                    "",
                    "if (pm.response.code >= 400) {",
                    "    pm.test('Unified API error format', function () {",
                    "        const body = pm.response.json();",
                    "        pm.expect(body).to.have.all.keys('message', 'errors');",
                    "        pm.expect(body.message).to.be.a('string').and.not.empty;",
                    "        pm.expect(body.errors === null || (typeof body.errors === 'object' && !Array.isArray(body.errors))).to.be.true;",
                    "    });",
                    "}"
                ]
            }
        }
    ],
