                    "name": "01 - Admin creates a catalog product (201)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Product is created', () => pm.response.to.have.status(201));",
                                    "pm.test('A new product starts with zero inventory', () => pm.expect(pm.response.json().data.available_quantity).to.eql(0));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
