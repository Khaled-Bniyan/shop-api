                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Postman Laptop\",\n    \"description\": \"Product used by the complete collection flow\",\n    \"price\": 850,\n    \"category_id\": {{category_id}}\n}",
                            "options": {"raw": {"language": "json"}}
                        },
                        "url": "{{base_url}}/products",
                        "description": "ينشئ المنتج الأساسي ويحفظ معرّفه لاستخدامه في الطلب. في قاعدة جديدة يكون المنتج 1 المتوافق مع بيانات المخزون الأولية."
                    }
                },
                {
                    "name": "02 - Admin creates product with image (201)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Multipart product request succeeds', () => pm.response.to.have.status(201));",
                                    "pm.test('Image URL is returned when a valid file is selected', function () {",
                                    "    const imageUrl = pm.response.json().data.image_url;",
                                    "    pm.expect(imageUrl === null || typeof imageUrl === 'string').to.be.true;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
                        "method": "POST",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "name", "value": "Camera With Image", "type": "text"},
                                {"key": "description", "value": "Multipart image upload example", "type": "text"},
                                {"key": "price", "value": "125.50", "type": "text"},
                                {"key": "category_id", "value": "{{category_id}}", "type": "text"},
                                {"key": "image", "type": "file", "src": "{{product_image_path}}"}
                            ]
                        },
                        "url": "{{base_url}}/products",
                        "description": "غيّر product_image_path إلى ملف JPG أو PNG أو WEBP حقيقي، أو اختر الملف من واجهة Postman. الحد الأقصى 2MB."
                    }
                },
                {
                    "name": "03 - List products with pagination (200)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Products are paginated', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.have.keys('data', 'links', 'meta');",
                                    "    pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                                    "    body.data.forEach(product => pm.expect(product.available_quantity).to.be.a('number'));",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{customer_a_token}}", "type": "string"}]},
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/products?page=1"
                    }
                },
                {
                    "name": "04 - Product details include available stock (200/503)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const expectUnavailable = pm.collectionVariables.get('expect_inventory_unavailable') === 'true';",
                                    "pm.test(expectUnavailable ? 'Inventory outage is mapped to 503' : 'Product details include stock', function () {",
                                    "    pm.response.to.have.status(expectUnavailable ? 503 : 200);",
                                    "    const body = pm.response.json();",
                                    "    if (expectUnavailable) {",
                                    "        pm.expect(body.message).to.be.a('string').that.is.not.empty;",
                                    "        pm.expect(body.errors).to.eql(null);",
                                    "    } else {",
                                    "        pm.expect(body.data.available_quantity).to.be.a('number');",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{customer_a_token}}", "type": "string"}]},
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/products/{{product_id}}",
                        "description": "في الوضع الطبيعي يعيد تفاصيل المنتج والكمية المتاحة من خدمة المخزون. لاختبار المهلة أو توقف الخدمة: أوقف inventory-service، واضبط expect_inventory_unavailable=true؛ يجب أن يعيد API حالة 503 بصيغة الخطأ الموحدة، ثم أعد تشغيل الخدمة وأعد المتغير إلى false."
                    }
                },
